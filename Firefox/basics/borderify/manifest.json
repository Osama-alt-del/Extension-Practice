{
    "manifest_version": 2,
    "name": "Borderify",
    "version": "1.0",
    "description": "Adds red border to all webpages matching mozilla",
    
    "icons": {
        "48": "icons/border-48.png"    
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "beastify@mozilla.org",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "content_scripts": [
        {
            "matches": ["*://*.mozilla.org/*"],
            "js": ["borderify.js"]
        }
    ]
}
